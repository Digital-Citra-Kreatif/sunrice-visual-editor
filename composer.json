{
    "name": "sunrice/visual-editor",
    "description": "Visual template editor for Sunrice CMS: edits the site's Blade files in the browser. A plugin for the Sunrice panel.",
    "type": "library",
    "keywords": [
        "sunrice",
        "cms",
        "laravel",
        "blade",
        "visual-editor"
    ],
    "require": {
        "php": "^8.4",
        "stillat/blade-parser": "^2.1",
        "sunrice/admin": "^0.2 || dev-main",
        "sunrice/cms": "^0.2 || dev-main"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Digital-Citra-Kreatif/sunrice-admin"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Digital-Citra-Kreatif/sunrice-cms"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sunrice\\VisualEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sunrice\\VisualEditor\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sunrice\\VisualEditor\\VisualEditorServiceProvider"
            ],
            "sunrice-plugins": [
                "Sunrice\\VisualEditor\\VisualEditorPlugin"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "spike": "php spike/run.php --check",
        "spike:css": "php spike/css.php --check",
        "workbench": [
            "@php vendor/bin/testbench workbench:create-sqlite-db",
            "@php vendor/bin/testbench workbench:build"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@workbench",
            "@php vendor/bin/testbench serve"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
